#step 9A
In /backend/src/services/solar-engine/ build the complete native solar calculation engine. No external APIs — all math is self-contained.

═══════════════════════════════════════
FILE: solar-calculator.ts
═══════════════════════════════════════

Export the following pure functions (all unit-tested):

/* ── 1. SYSTEM SIZING ── */
export function recommendSystemSize(input: {
  monthlyBillAvg: number,     // ₹
  tariffPerUnit: number,       // ₹/kWh
  peakSunHours?: number,       // default 5.5 for Delhi
  systemEfficiency?: number,   // default 0.80 (80%)
}): { recommendedKw: number, monthlyConsumptionKwh: number }

Logic:
  monthlyConsumptionKwh = monthlyBillAvg / tariffPerUnit
  dailyConsumptionKwh = monthlyConsumptionKwh / 30
  recommendedKw = dailyConsumptionKwh / (peakSunHours × systemEfficiency)
  Round up to nearest 0.5 kW


/* ── 2. PANEL COUNT ── */
export function calculatePanelCount(systemKw: number, panelWattage: number): number
  panelCount = ceil(systemKw × 1000 / panelWattage)


/* ── 3. ANNUAL GENERATION ── */
export function calculateAnnualGeneration(input: {
  systemKw: number,
  performanceRatio?: number,   // default 0.75
  peakSunHours?: number,       // default 5.5
}): { annualKwh: number, monthlyBreakdown: MonthlyGeneration[] }

Monthly peak sun hours for Delhi (hardcoded lookup table):
  Jan:4.8, Feb:5.2, Mar:5.8, Apr:6.2, May:6.5, Jun:5.5,
  Jul:4.5, Aug:4.8, Sep:5.2, Oct:5.5, Nov:5.0, Dec:4.6

monthlyKwh[m] = systemKw × PR × peakSunHours[m] × daysInMonth[m]
annualKwh = sum of all monthlyKwh


/* ── 4. SUBSIDY CALCULATION ── */
export function calculateSubsidy(input: {
  systemKw: number,
  scheme: 'PM_SURYA_GHAR' | 'CM_SCHEME' | 'BOTH' | 'NONE',
  state?: string,              // default 'DELHI'
}): {
  pmSuryaGharAmount: number,
  cmSchemeAmount: number,
  totalSubsidy: number,
  slabBreakdown: SubsidySlab[],
}

PM Surya Ghar slabs (update via admin config, hardcoded defaults):
  ≤ 1 kW: ₹30,000/kW
  1–2 kW: ₹30,000/kW (for first kW) + ₹30,000/kW (for remaining, capped)
  2–3 kW: ₹60,000 (for 2kW) + ₹18,000 (for the extra kW)
  > 3 kW: capped at ₹78,000 total
  
Delhi CM Scheme (configurable defaults):
  ≤ 3 kW: ₹2,000/kW additional
  > 3 kW: ₹6,000 flat

Return slabBreakdown array showing how each slab is applied.


/* ── 5. FINANCIAL CALCULATIONS ── */
export function calculateFinancials(input: {
  totalSystemCost: number,
  subsidyAmount: number,
  annualKwh: number,
  tariffPerUnit: number,
  annualTariffEscalation?: number,  // default 0.03 (3% per year)
  systemLifeYears?: number,          // default 25
  loanAmount?: number,
  loanRatePercent?: number,
  loanTenureMonths?: number,
}): FinancialResult

FinancialResult = {
  netCost: number,                    // totalCost - subsidy
  annualSavingsYear1: number,         // annualKwh × tariff
  paybackYears: number,               // netCost / avgAnnualSavings
  lifetimeSavings: number,            // sum of savings over 25yr with escalation
  roi25yr: number,                    // % return
  irr: number,                        // IRR using Newton-Raphson on cash flows
  emi: number | null,                 // monthly EMI if loan
  loanTotalCost: number | null,       // total paid incl. interest
  yearlyProjection: YearlyProjection[], // 25 rows: year, generation, savings, cumulative
}

IRR calculation:
  cashFlows = [-netCost, savingsY1, savingsY2, ... savingsY25]
  Use Newton-Raphson iteration (max 100 iterations, tolerance 0.0001)
  
EMI formula: P × r × (1+r)^n / ((1+r)^n - 1)
  where r = monthlyRate, n = tenureMonths

CO2 savings:
  co2KgPerYear = annualKwh × 0.716  // India grid emission factor kg CO2/kWh
  co2TonnesPer25yr = co2KgPerYear × 25 / 1000
  treesEquivalent = co2TonnesPer25yr × 1000 / 21.7  // avg tree absorbs 21.7kg/yr

export function calculateCO2(annualKwh: number): CO2Result


/* ── 6. ROOF AREA VALIDATOR ── */
export function validateRoofForSystem(input: {
  roofAreaSqFt: number,
  systemKw: number,
  panelWattage: number,
}): { fits: boolean, requiredSqFt: number, availableSqFt: number, maxKwForRoof: number }

Area per panel: 580W panel ≈ 32 sq ft, 540W ≈ 30 sq ft, 440W ≈ 26 sq ft
Use lookup: wattage → sqft/panel (configurable table)
Also account for row spacing shadow clearance (1.5× panel height)


/* ── 7. STRING CONFIGURATION ── */
export function calculateStringConfig(input: {
  panelCount: number,
  inverterModel: InverterSpec,   // { maxInputVoltage, mpptVoltageRange, maxInputCurrent, mpptCount }
  panelSpec: PanelSpec,          // { voc, vmpp, isc, impp, tempCoeffVoc }
  minAmbientTemp?: number,       // default -5°C for Delhi winter
  maxAmbientTemp?: number,       // default 45°C Delhi summer
}): StringConfig

StringConfig = {
  stringsCount: number,
