═══════════════════════════════════════
SUN POSITION MATH
═══════════════════════════════════════

export function getSunPosition(input: {
  date: Date,
  lat: number,     // Delhi: 28.6144
  lng: number,     // Delhi: 77.2090
  timezone: number // India: +5.5
}): SunPosition

// Spencer's equation for day of year
dayOfYear = getDayOfYear(date)
B = 360/365 × (dayOfYear - 81) in degrees

// Equation of time (minutes)
EoT = 9.87×sin(2B) - 7.53×cos(B) - 1.5×sin(B)

// Solar declination
declination = 23.45 × sin(B)

// Local solar time
solarTime = clockTime + EoT/60 + (lng - timezone×15)/15

// Hour angle (15° per hour from solar noon)
hourAngle = 15 × (solarTime - 12)

// Solar elevation
elevation = arcsin(sin(lat)×sin(dec) + cos(lat)×cos(dec)×cos(hourAngle))

// Solar azimuth (degrees from North, clockwise)
azimuth = arctan2(-cos(dec)×sin(hourAngle), 
           sin(lat)×cos(dec)×cos(hourAngle) - cos(lat)×sin(dec))
azimuth = (azimuth + 360) % 360

SunPosition = { elevation: number, azimuth: number, isAboveHorizon: boolean }


═══════════════════════════════════════
SHADOW CASTING
═══════════════════════════════════════

export function castPanelRowShadow(input: {
  panelHeightM: number,
  panelTiltDeg: number,
  panelAzimuthDeg: number,
  sunElevationDeg: number,
  sunAzimuthDeg: number,
}): number  // shadow length in meters

// Project panel height onto horizontal plane accounting for tilt
effectiveHeight = panelHeightM × sin(tiltDeg)
shadowLength = effectiveHeight / tan(sunElevationDeg)
// Project shadow in sun direction (perpendicular component)
shadowInRowDirection = shadowLength × cos(panelAzimuthDeg - sunAzimuthDeg)
return max(0, shadowInRowDirection)


