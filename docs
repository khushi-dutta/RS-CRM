═══════════════════════════════════════
ANNUAL SHADING ANALYSIS
═══════════════════════════════════════

export async function runAnnualShadingAnalysis(input: {
  panels: PanelPosition[],
  roofTiltDeg: number,
  roofAzimuthDeg: number,
  obstructions: Obstruction3D[],
  lat: number,
  lng: number,
  sampleHoursPerDay?: number,   // default 9 (8am-4pm)
  sampleDaysPerMonth?: number,  // default 4 (representative days)
}): Promise<ShadingReport>

Algorithm:
  For each month (12):
    Pick 4 representative days
    For each day, simulate sun from 8am to 4pm (hourly)
    For each hour with sun elevation > 5°:
      For each panel:
        Check isPointShaded for panel center + 4 corners
        Panel shading fraction = shaded_check_points / 5
    Monthly shading loss = avg(panel shading fractions) weighted by irradiance
  
  Annual shading loss = weighted average of monthly losses

ShadingReport = {
  annualLossPercent: number,
  monthlyLoss: { month: number, lossPercent: number }[],
  panelShading: { panelId: number, annualLossPercent: number }[],  // per-panel
  heatmapData: { panelId: number, color: string }[],  // for 3D viewer
  worstMonth: string,
  recommendation: string,  // e.g. "Consider trimming the tree on the north side"
}

Run this as a Web Worker to avoid blocking the UI thread:
